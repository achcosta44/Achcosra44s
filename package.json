{
  "name": "consultorio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply consultorio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply consultorio-db --remote",
    "db:backup": "wrangler d1 export consultorio-db --remote --output=backup-$(date +%Y%m%d-%H%M).sql",
    "typecheck": "tsc --noEmit",
    "build:celular": "node scripts/build-celular.mjs",
    "sync:dev": "cd sync && wrangler d1 migrations apply consultorio-sync --local && wrangler dev --port 8788",
    "sync:deploy": "cd sync && wrangler deploy",
    "dados-teste": "node scripts/gerar-dados-teste.mjs",
    "test:offline": "node tests/fluxo-offline.cjs",
    "test:sync": "node tests/sincronizacao.cjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.150.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
